#: cghanafuda/koikoi-game.c:581
msgid ""
"Both hands as dealt are four of a month or four pairs:\n"
"no one scores."
msgstr ""
"Обе розданные руки — четыре карты одного месяца или четыре пары:\n"
"никто не получает очков."

#: cghanafuda/koikoi-game.c:589
msgid "Your hand as dealt wins: four of a month, or four pairs."
msgstr ""
"Ваша розданная рука выигрывает: четыре карты одного месяца или четыре пары."

#: cghanafuda/koikoi-game.c:590
msgid "The computer's hand as dealt wins: four of a month, or four pairs."
msgstr ""
"Розданная рука компьютера выигрывает: четыре карты одного месяца или четыре "
"пары."

#: cghanafuda/koikoi-game.c:601
msgid "You deal, and lead."
msgstr "Вы сдаёте и ходите первым."

#: cghanafuda/koikoi-game.c:602
msgid "The computer deals, and leads."
msgstr "Компьютер сдаёт и ходит первым."

#: cghanafuda/koikoi-game.c:632
#, c-format
msgid "You turned %s (%s), the computer %s (%s): you deal."
msgstr "Вы открыли %s (%s), компьютер — %s (%s): сдаёте вы."

#: cghanafuda/koikoi-game.c:633
#, c-format
msgid "You turned %s (%s), the computer %s (%s): the computer deals."
msgstr "Вы открыли %s (%s), компьютер — %s (%s): сдаёт компьютер."

#: cghanafuda/koikoi-game.c:664
msgid "Koi-koi! Play on."
msgstr "Кой-кой! Игра продолжается."

#: cghanafuda/koikoi-game.c:665
msgid "Koi-koi! The next yaku ends the round."
msgstr "Кой-кой! Следующее яку завершит раунд."

#: cghanafuda/koikoi-game.c:699
msgid "Stop"
msgstr "Стоп"

#: cghanafuda/koikoi-game.c:702
#, c-format
msgid ""
"%s\n"
"\n"
"%d point. Stop and take it, or call koi-koi and play on for more?"
